        {
          "path": "audio/narration_sentences/m5-l15-v3-final-review/scene-06-cue-02.wav",
          "sha256": "95ed6bb2393131252b663a06664862622318abb4d40718c268c4a2a3a52326ff"
        },
        {
          "path": "audio/narration_sentences/m5-l15-v3-final-review/scene-06-cue-03.wav",
